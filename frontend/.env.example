# Copy to .env.production before `npm run build` for Hostinger. Development needs no .env
# (Vite proxies /api to the server on localhost:4000).

# The API, on the DigitalOcean droplet
VITE_API_URL=https://api.zoltanvisa.com
# Where PDFs and videos are loaded from and uploaded to: your Cloudflare R2 S3 endpoint
VITE_STORAGE_ORIGIN=https://<account-id>.r2.cloudflarestorage.com
