{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma": "node --env-file=../../.env ../../node_modules/prisma/build/index.js",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:deploy": "npm run prisma -- migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "test:integration": "node --env-file=../../.env ../../node_modules/vitest/vitest.mjs run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@app/shared": "*",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.4.0",
    "prisma": "^6.19.3",
    "puppeteer": "^25.16.0",
    "tsx": "^4.23.15",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/yazl": "^3.3.1",
    "supertest": "^7.3.2"
  }
}
