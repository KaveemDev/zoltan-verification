# systemd service for the API (installed by deploy/setup.sh). Restarts on failure and on reboot.
#   status: systemctl status zoltan-api      logs: journalctl -u zoltan-api -f
[Unit]
Description=Zoltan agreements API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zoltan
WorkingDirectory=/opt/zoltan/server
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
