# Copy to server/.env. Never commit .env.
# Defaults below work for local development. Production values are in the comments
# (frontend on Hostinger at sign.zoltanvisa.com, API on a DigitalOcean droplet at api.zoltanvisa.com).
NODE_ENV=development
PORT=4000
# Reverse proxies in front of the API: 1 on the droplet (Caddy)
TRUST_PROXY=1

DATABASE_URL=postgresql://app:app@localhost:5432/agreements?schema=public
# Droplet only: password for the Postgres container (letters and digits only). docker-compose.yml then sets DATABASE_URL itself.
POSTGRES_PASSWORD=

# Generate each with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SIGNING_SESSION_SECRET=change-me-to-another-long-random-string-32-chars

# Production: https://sign.zoltanvisa.com and https://api.zoltanvisa.com
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000
# Production: .zoltanvisa.com (lets the staff login cookie work across sign. and api.). Leave empty locally.
COOKIE_DOMAIN=
# Production: api.zoltanvisa.com (Caddy gets its HTTPS certificate for this name)
API_DOMAIN=api.zoltanvisa.com

BUSINESS_NAME="Zoltan Visa"
TOKEN_TTL_HOURS=72

# File storage. Local: MinIO. Production: Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto  S3_SSE=none
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=agreements
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# AES256 (MinIO, AWS S3) or none (Cloudflare R2: always encrypted at rest, rejects the header)
S3_SSE=AES256

# Signing link by email. console = print to the API log (dev only); zeptomail in production.
EMAIL_PROVIDER=console
# ZeptoMail → Mail Agents → SMTP/API → Send Mail token (with or without the "Zoho-enczapikey " prefix)
ZEPTOMAIL_API_KEY=
ZEPTOMAIL_API_HOST=api.zeptomail.in
# Must be on a domain verified in ZeptoMail
EMAIL_FROM=noreply@gb.zoltanvisa.com
SUPPORT_EMAIL=support@zoltanvisa.com

# One-time code. Numbers starting with SMS_COUNTRY_CODES get an SMS; everyone else gets an email.
# console = print to the API log (dev only); msg91 in production (needs DLT registration).
SMS_PROVIDER=console
MSG91_AUTH_KEY=
# MSG91 template ID of the DLT-approved OTP template; its variable must be named ##otp##
MSG91_OTP_TEMPLATE_ID=
SMS_COUNTRY_CODES=+91

# Years after signing (or creation, if never signed) before a record is flagged for deletion
RETENTION_YEARS=3
# Nightly database backup to the bucket (docker-compose.yml turns it on)
DB_BACKUPS=off
BACKUP_RETENTION_DAYS=30
# 1 inside containers, where Chrome's sandbox can't start (the Dockerfile sets it)
PUPPETEER_NO_SANDBOX=0

# Used only by `npm run db:seed` to create the first admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
