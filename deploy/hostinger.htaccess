# Hostinger (LiteSpeed/Apache) config for sign.zoltanvisa.com.
# ${API_ORIGIN} and ${S3_PUBLIC_ORIGIN} are filled in by .github/workflows/deploy-frontend.yml.
# Turn on "Force HTTPS" for the subdomain in hPanel (a rewrite rule here can loop behind Hostinger's proxy).
Options -Indexes

# Single-page app: every route that isn't a real file serves index.html.
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  # Signing URLs carry the token: never leak them in a Referer header.
  Header always set Referrer-Policy "no-referrer"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
  # API on its own subdomain; PDFs and videos straight from R2; pdf.js needs wasm and data:/blob: fonts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: blob: https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob: ${S3_PUBLIC_ORIGIN}; connect-src 'self' ${API_ORIGIN} ${S3_PUBLIC_ORIGIN}; frame-src ${S3_PUBLIC_ORIGIN}; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Vite's bundles have content hashes in their names, so they never change.
  <FilesMatch "\.(js|mjs|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
